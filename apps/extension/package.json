  "scripts": {
    "postinstall": "mkdir -p ~/.talisman-dev/chrome-data && wxt prepare",
    "chore:update-translations": "pnpm exec i18next-cli extract --config i18next.config.ts",
    "chore:download-translations": "pnpm tsx scripts/download-translations.ts",
    "chore:codegen:stealthex-swaps": "openapi-typescript https://stealthex.talisman.xyz/docs/openapi.json --export-type --root-types -o src/ui/domains/Swap/swap-modules/stealthex.api.gen.ts",
    "chore:generate-clients:sn45": "pnpm dlx swagger-typescript-api@13.6.2 generate -p https://sn45api.talisman.xyz/openapi.json -o ./src/core/domains/bittensor/sn45 -n Sn45Api.gen.ts --api-class-name Sn45Api",
    "chore:generate-clients:tda": "pnpm dlx swagger-typescript-api@13.6.2 generate -p https://tda.talisman.xyz/openapi.json -o ./src/core/domains/bittensor/tao-data -n TaoDataApi.gen.ts --api-class-name TaoDataApi",
    "chore:generate-clients:wrc": "pnpm dlx swagger-typescript-api@13.6.2 generate -p https://wrc.talisman.xyz/openapi.json -o ./src/core/domains/app/remote-config -n RemoteConfigApi.gen.ts --api-class-name RemoteConfigApi",
    "chore:generate-clients:wrc:local": "pnpm dlx swagger-typescript-api@13.6.2 generate -p http://localhost:8787/openapi.json -o ./src/core/domains/app/remote-config -n RemoteConfigApi.gen.ts --api-class-name RemoteConfigApi",
    "chore:generate-clients:sn45:local": "pnpm dlx swagger-typescript-api@13.6.2 generate -p http://localhost:8787/openapi.json -o ./src/core/domains/bittensor/sn45 -n Sn45Api.gen.ts --api-class-name Sn45Api",
    "chore:generate-clients:tda:local": "pnpm dlx swagger-typescript-api@13.6.2 generate -p http://localhost:8787/openapi.json -o ./src/core/domains/bittensor/tao-data -n TaoDataApi.gen.ts --api-class-name TaoDataApi",
    "chore:generate-clients": "pnpm chore:generate-clients:sn45 && pnpm chore:generate-clients:tda && pnpm chore:generate-clients:wrc",
    "chore:generate-init-data": "tsx scripts/generateRemoteConfigInitData.ts && tsx --conditions=@talismn/source scripts/generateTvlAllowList.ts",
    "chore:register-gandalf-e2e": "pnpm --silent tsx scripts/register-gandalf-e2e.ts",
    "posthog:provision": "tsx --conditions=@talismn/source --env-file-if-exists=.env scripts/posthog/provision.ts",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:kill": "lsof -ti:8254 | xargs kill -9 2>/dev/null || true",
    "build": "wxt zip",
    "build:firefox": "wxt zip -b firefox",
    "build:prod": "BUILD_TYPE=production wxt zip",
    "build:prod:firefox": "BUILD_TYPE=production wxt zip -b firefox",
    "build:canary": "BUILD_TYPE=canary wxt zip",
    "build:canary:firefox": "BUILD_TYPE=canary wxt zip -b firefox",
    "build:analyze": "wxt build --analyze",
    "build:analyze:firefox": "wxt build -b firefox --analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .wxt node_modules coverage .turbo .i18next-parser",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  }
}
