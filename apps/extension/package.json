  "scripts": {
    "postinstall": "mkdir -p ~/.talisman-dev/chrome-data",
    "chore:update-translations": "pnpm exec i18next --silent --config i18next-parser.config.cjs",
    "chore:download-translations": "pnpm tsx scripts/download-translations.ts",
    "chore:codegen:stealthex-swaps": "openapi-typescript https://stealthex.talisman.xyz/docs/openapi.json --export-type --root-types -o src/ui/domains/Swap/swap-modules/stealthex.api.d.ts",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:kill": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "build": "wxt zip",
    "build:firefox": "wxt zip -b firefox --mv3",
    "build:prod": "BUILD_TYPE=production wxt zip",
    "build:prod:firefox": "BUILD_TYPE=production wxt zip -b firefox --mv3",
    "build:canary": "BUILD_TYPE=canary wxt zip",
    "build:canary:firefox": "BUILD_TYPE=canary wxt zip -b firefox --mv3",
    "build:analyze": "wxt build --analyze",
    "build:analyze:firefox": "wxt build -b firefox --mv3 --analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0 --ext ts,tsx",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "clean": "rm -rf dist .wxt node_modules coverage .turbo .i18next-parser",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@talismn/eslint-config/react"
    ]
  }
}
