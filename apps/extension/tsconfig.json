{
  "extends": "@talismn/tsconfig/es6-react.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "paths": {
      "@common": ["./src/common"],
      "@common/*": ["./src/common/*"],
      "@core": ["./src/core"],
      "@core/*": ["./src/core/*"],
      "@ui": ["./src/ui"],
      "@ui/*": ["./src/ui/*"],
      "@tests": ["./src/tests"],
      "@tests/*": ["./src/tests/*"],
      "inject/*": ["./src/inject/*"]
    }
  },
  "include": [
    ".wxt/wxt.d.ts",
    "i18next-parser.config.cjs",
    "src",
    "src/**/*.json",
    "entrypoints",
    "scripts",
    "wxt.config.ts",
    "tests"
  ],
  "exclude": ["**/node_modules"]
}
