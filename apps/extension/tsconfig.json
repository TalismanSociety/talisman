{
  "extends": "@talismn/tsconfig/es6-react.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "src",
    "moduleResolution": "bundler",
    "paths": {
      "@common": ["./common"],
      "@common/*": ["./common/*"],
      "@talisman": ["./@talisman"],
      "@talisman/*": ["./@talisman/*"],
      "@ui": ["./ui"],
      "@ui/*": ["./ui/*"],
      "@tests": ["./tests"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    ".wxt/wxt.d.ts",
    "i18next-parser.config.cjs",
    "src",
    "entrypoints",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["**/node_modules", "**/.*/", "**/*.spec.ts", "**/*.test.ts"]
}
