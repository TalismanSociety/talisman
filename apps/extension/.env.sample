# NOTE: env files never enter Docker build contexts (see .dockerignore), so
# Firefox release builds are always built without them. Sentry/PostHog are
# disabled on Firefox at runtime anyway; these values only affect Chrome builds.

# for dev only, used to unlock the wallet without typing the password
# PASSWORD=MyL33TP@55w0rd

# for dev only, registers a local subtensor node as a bittensor network (with its subnet tokens)
# BITTENSOR_DEVNET_RPC=ws://127.0.0.1:9944

# for dev only, logs every call of the injected EVM provider in the dapp's console
# EVM_LOGPROXY=true

# for dev only, logs each subscription update that the UI receives, with its transfer time from the background
# LOG_SUBSCRIPTION_CALLBACKS=1

# Sentry settings, required for canary and prod builds only
# SENTRY_AUTH_TOKEN=
# SENTRY_DSN=

# Posthog auth token, required for canary and prod builds only (unless developing analytics features)
# POSTHOG_AUTH_TOKEN=

# Prod/canary only, used by `pnpm chore:download-translations`
# SIMPLE_LOCALIZE_API_KEY=

# to run e2e tests faster - generate with `pnpm chore:register-gandalf-e2e`
# E2E_GANDALF_INSTALL_ID=
# E2E_GANDALF_PRIVATE_KEY=

# e2e wallet mnemonic (default: the anvil test mnemonic)
# E2E_TESTS_MNEMONIC=

# e2e extension build to load (default: dist/chrome-mv3, else dist/chrome-mv3-dev)
# E2E_EXTENSION_PATH=apps/extension/dist/chrome-mv3-dev

# optional API keys for `pnpm test:api`
# TDA_API_KEY=
# SN45_API_KEY=

# SHELL ONLY: wxt.config.ts reads these when it is imported, before WXT loads this
# file. Set them in the shell (e.g. `NOBROWSER=1 pnpm dev`). WXT ignores a value
# in this file, or applies it to only some of the build.

# `pnpm dev` builds without opening a browser (load dist/chrome-mv3-dev yourself)
# NOBROWSER=1

# overrides the Sentry release name (default: <version>-<buildType>-<git sha>)
# SENTRY_RELEASE=

# overrides the git sha in the build name and zip file name (CI sets it)
# COMMIT_SHA_SHORT=

# overrides public/locales/languages.json: JSON map of language code to name
# (`pnpm chore:download-translations` also reads it, from the shell or from this file)
# SUPPORTED_LANGUAGES={"en":"English"}
