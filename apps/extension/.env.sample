# NOTE: env files never enter Docker build contexts (see .dockerignore), so
# Firefox release builds are always built without them. Sentry/PostHog are
# disabled on Firefox at runtime anyway; these values only affect Chrome builds.

# for dev only, used to unlock the wallet without typing the password
# PASSWORD=MyL33TP@55w0rd

# for dev only, used to pre-fill mnemonic on 'add account' selection screen
# TEST_MNEMONIC=blarg blarg blarg blarg blarg blarg blarg blarg blarg blarg blarg blarg

# for dev only, registers a local subtensor node as a bittensor network (with its subnet tokens)
# BITTENSOR_DEVNET_RPC=ws://127.0.0.1:9944

# Sentry settings, required for canary and prod builds only
# SENTRY_AUTH_TOKEN=
# SENTRY_DSN=
# SENTRYCLI_USE_LOCAL=1

# Posthog auth token, required for canary and prod builds only (unless developing analytics features)
# POSTHOG_AUTH_TOKEN=

# Prod/canary only
# SIMPLE_LOCALIZE_API_KEY=
# SIMPLE_LOCALIZE_PROJECT_TOKEN=

# to run e2e tests faster - generate with `pnpm chore:register-gandalf-e2e`
# E2E_GANDALF_INSTALL_ID=
# E2E_GANDALF_PRIVATE_KEY=