  },
  "devDependencies": {
    "@talismn/tsconfig": "workspace:*",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^24.5.1",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@talismn/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
