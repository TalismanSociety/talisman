{
  "name": "@talismn/sapi",
  "version": "0.1.0",
  "author": "Talisman",
  "homepage": "https://talisman.xyz",
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/sapi",
    "type": "git",
    "url": "https://github.com/talismansociety/talisman.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "clean": "rm -rf dist .turbo node_modules",
    "build": "tsup --silent",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polkadot-api/merkleize-metadata": "1.1.18",
    "@polkadot-api/metadata-builders": "0.12.2",
    "@polkadot-api/substrate-bindings": "0.14.0",
    "@polkadot-api/utils": "0.2.0",
    "@polkadot/types": "16.1.2",
    "@polkadot/types-codec": "16.1.2",
    "@polkadot/util": "13.5.3",
    "@talismn/scale": "workspace:*",
    "anylogger": "^1.0.11",
    "polkadot-api": "1.13.1",
    "scale-ts": "^1.6.1"
  },
  "devDependencies": {
    "@talismn/eslint-config": "workspace:*",
    "@talismn/tsconfig": "workspace:*",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@talismn/eslint-config/base"
    ]
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
