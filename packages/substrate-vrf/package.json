{
  "name": "@talismn/substrate-vrf",
  "version": "1.0.0",
  "description": "sr25519 VRF sign/verify in the origin-bound substrate-vrf namespace, as produced by the Talisman wallet's signer.signVrf (built for Orbinum)",
  "keywords": [
    "sr25519",
    "vrf",
    "substrate",
    "orbinum"
  ],
  "author": "Talisman",
  "homepage": "https://talisman.xyz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "directory": "packages/substrate-vrf",
    "type": "git",
    "url": "https://github.com/TalismanSociety/talisman.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "clean": "rm -rf dist .turbo node_modules",
    "build": "tsdown -l error",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scure/sr25519": "2.2.0"
  },
  "devDependencies": {
    "@scure/base": "2.2.0",
    "@talismn/tsconfig": "workspace:*",
    "typescript": "^7.0.2"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@talismn/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
