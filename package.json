{
  "name": "talisman",
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "postinstall": "pnpm papi:once",
    "prepare": "[ \"$(git config core.hooksPath)\" != .husky/_ ] || git config --unset core.hooksPath; simple-git-hooks",
    "papi": "papi",
    "papi:once": "test -d .papi/descriptors/dist && echo 'existing papi descriptors found! run \"pnpm papi\" to regenerate them' || papi",
    "papi:update": "papi update",
    "format": "biome format --write .",
    "chore:update-translations": "pnpm run --filter extension chore:update-translations",
    "chore:update:translations": "pnpm chore:update-translations",
    "chore:download-translations": "pnpm run --filter extension chore:download-translations",
    "update:translations": "pnpm chore:update-translations",
    "chore:generate-clients": "pnpm -r chore:generate-clients",
    "chore:register-gandalf-e2e": "pnpm --silent run --filter extension chore:register-gandalf-e2e",
    "posthog:provision": "pnpm --silent run --filter extension posthog:provision",
    "chore:generate-init-data": "pnpm -r chore:generate-init-data",
    "chore:prepare-release": "pnpm chore:generate-clients && pnpm chore:generate-init-data && pnpm chore:download-translations && pnpm biome check --fix && pnpm typecheck",
    "dev": "pnpm dev:extension",
    "dev:firefox": "pnpm dev:extension:firefox",
    "dev:extension": "pnpm run --filter extension dev",
    "dev:extension:firefox": "pnpm run --filter extension dev:firefox",
    "dev:kill": "pnpm run --filter extension dev:kill",
    "build": "pnpm run --filter extension build",
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "build:extension": "pnpm run --filter extension build",
    "build:extension:firefox": "pnpm run --filter extension build:firefox",
    "build:extension:prod": "pnpm run --filter extension build:prod",
    "build:extension:prod:firefox": "./scripts/build-firefox-docker.sh",
    "build:extension:canary": "pnpm run --filter extension build:canary",
    "build:extension:canary:firefox": "pnpm run --filter extension build:canary:firefox",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "check:fix:unsafe": "biome check --fix --unsafe .",
    "typecheck": "pnpm run -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm exec playwright test --project=chromium",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:debug": "pnpm exec playwright test --project=chromium --debug",
    "test:e2e:trace": "pnpm exec playwright test --project=chromium --trace on && pnpm exec playwright show-report",
    "test:e2e:stress": "pnpm exec playwright test --project=chromium --repeat-each=10 --workers 1 --trace on",
    "devnet:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "devnet:down": "docker compose -f docker-compose.test.yml down -v",
    "devnet:logs": "docker compose -f docker-compose.test.yml logs -f",
    "clean": "pnpm run -r --parallel clean & rm -rf .wxt dist coverage test-results playwright-report .turbo node_modules review & wait",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "knip:production": "knip --production",
    "check:licenses": "node scripts/check-direct-licenses.mjs",
    "verify": "pnpm check:licenses && pnpm biome check --error-on-warnings --changed --since=origin/dev --no-errors-on-unmatched && pnpm knip && pnpm typecheck && pnpm test"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/biome check --staged --error-on-warnings --no-errors-on-unmatched"
  },
  "dependencies": {
    "polkadot-api": "3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@svgr/rollup": "8.1.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "5.0.5",
    "dotenv": "18.0.9",
    "knip": "6.44.1",
    "simple-git-hooks": "2.14.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
